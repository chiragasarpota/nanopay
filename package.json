{
  "name": "nanopay",
  "version": "0.1.0",
  "description": "Nano cryptocurrency toolkit for keys, addresses, exact unit conversion, block signing and proof of work.",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": "./dist/nanopay.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/build.mjs",
    "tsconfig.json",
    "NOTICE",
    "CHANGELOG.md",
    "native/",
    "scripts/build-wasm.mjs",
    "docs/"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "chiragasarpota",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiragasarpota/nanopay.git"
  },
  "bugs": {
    "url": "https://github.com/chiragasarpota/nanopay/issues"
  },
  "homepage": "https://github.com/chiragasarpota/nanopay#readme",
  "keywords": [
    "nano",
    "cryptocurrency",
    "toolkit"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "module": "./dist/index.js",
  "bin": {
    "nanopay": "./dist/cli.js"
  },
  "sideEffects": [
    "./dist/nanopay.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js test/upstream/*.test.js",
    "test:browser": "node --test test/browser/*.test.js",
    "test:package": "node scripts/check-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run format:check && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "build:wasm": "node scripts/build-wasm.mjs",
    "bench": "npm run build && node scripts/benchmark.mjs",
    "release:bootstrap": "node scripts/publish-bootstrap.mjs"
  },
  "dependencies": {
    "blakejs": "^1.2.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "esbuild": "^0.28.2",
    "expect": "^30.5.1",
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "@playwright/test": "^1.63.0"
  },
  "contributors": [
    {
      "name": "Marvin ROGER",
      "url": "https://github.com/marvinroger"
    }
  ]
}
